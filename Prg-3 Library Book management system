class Book:
    """Base class for a book record."""
    def __init__(self, book_id, title, author, price):
        self.book_id = book_id
        self.title = title
        self.author = author
        self.price = price
        self.category = "Standard"  # default, overridden by subclasses

    def display(self):
        print(f"ID: {self.book_id} | Title: {self.title} | Author: {self.author} "
              f"| Price: ₹{self.price} | Category: {self.category}")


class PremiumBook(Book):
    """Books priced above a threshold (or explicitly marked premium)."""
    def __init__(self, book_id, title, author, price):
        super().__init__(book_id, title, author, price)
        self.category = "Premium"


class StandardBook(Book):
    """Regular books."""
    def __init__(self, book_id, title, author, price):
        super().__init__(book_id, title, author, price)
        self.category = "Standard"


class Library:
    """Manages a collection of Book objects."""
    def __init__(self):
        self.books = []

    def add_book(self, book):
        # Prevent duplicate Book IDs
        if any(b.book_id == book.book_id for b in self.books):
            print(f"Book ID {book.book_id} already exists. Skipping.")
            return
        self.books.append(book)
        print(f"Added: {book.title}")

    def display_all_books(self):
        if not self.books:
            print("No books in the library yet.")
            return
        print("\n--- Library Records ---")
        for book in self.books:
            book.display()
        print("------------------------\n")


def main():
    library = Library()

    # Sample books — Premium if price > 500, else Standard
    book_data = [
        (101, "Clean Code", "Robert C. Martin", 650),
        (102, "Atomic Habits", "James Clear", 399),
        (103, "The Pragmatic Programmer", "Andy Hunt", 720),
        (104, "Ikigai", "Héctor García", 299),
    ]

    for book_id, title, author, price in book_data:
        if price > 500:
            book = PremiumBook(book_id, title, author, price)
        else:
            book = StandardBook(book_id, title, author, price)
        library.add_book(book)

    library.display_all_books()


if __name__ == "__main__":
    main()
